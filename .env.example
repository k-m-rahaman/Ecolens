# Offline mode works without a key. Never commit a populated .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set to 1 only after confirming the provider project has NO billing enabled.
FREE_TIER_ONLY=0
DAILY_SCAN_LIMIT=20
SCANS_PER_MINUTE=3
# Optional: exact origin when using a separate frontend (no wildcard).
ALLOWED_ORIGIN=
PORT=8787
# Optional same-Wi-Fi photo-upload preview. Also enabled by npm start -- --lan.
# Phone camera and offline preparation require HTTPS; HTTP LAN preview does not.
LAN_PREVIEW=0
# Optional comma-separated private IPv4 hosts; local adapters are detected automatically.
# Only 10.x.x.x, 172.16-31.x.x and 192.168.x.x are accepted.
LAN_HOSTS=

# Shared NAAC report only. Private student records never leave the browser.
NAAC_SHARING_ENABLED=0
# Exact origins allowed to submit anonymous institution totals; no wildcard.
NAAC_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
NAAC_PUBLISHES_PER_MINUTE=4
NAAC_PUBLISHES_PER_IP_DAY=60
NAAC_PUBLISHES_PER_DAY=500
